{
  "name": "pi-async-shell",
  "version": "0.2.3",
  "packageManager": "pnpm@12.21.0",
  "description": "Durable asynchronous shell commands for Pi with bounded waits, searchable logs, PTY input, and workspace recovery.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Zhuocheng-Lang",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "shell",
    "async",
    "pty",
    "background",
    "durable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhuocheng-Lang/pi-async-shell.git"
  },
  "homepage": "https://github.com/Zhuocheng-Lang/pi-async-shell#readme",
  "bugs": {
    "url": "https://github.com/Zhuocheng-Lang/pi-async-shell/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "linux"
  ],
  "files": [
    "src/",
    "docs/",
    "skills/",
    "bench/REPORT.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/Zhuocheng-Lang/pi-async-shell/main/docs/assets/logo.png",
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "scripts": {
    "link-host": "node scripts/link-host.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:unit": "node --test --test-concurrency=1 tests/log-manager.test.ts tests/maintenance.test.ts tests/manifest.test.ts tests/pattern.test.ts tests/properties.test.ts tests/reload.test.ts tests/screen.test.ts tests/shell-policy.test.ts",
    "bench": "node bench/run-bench.ts",
    "spec:typecheck": "quint typecheck spec/handle-lifecycle.qnt",
    "spec:run": "quint run spec/handle-lifecycle.qnt --max-samples=5000 --max-steps=20 --invariant=invariants",
    "spec": "pnpm run spec:typecheck && pnpm run spec:run",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:prose": "vale docs/",
    "docs:links": "lychee --config lychee.toml --offline --no-progress \"docs/**/*.md\" README.md README.zh-CN.md CONTRIBUTING.md",
    "docs": "pnpm run check:docs && pnpm run docs:prose && pnpm run docs:links",
    "verify": "pnpm run typecheck && pnpm test && pnpm run check:docs",
    "prepublishOnly": "pnpm verify"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@informalsystems/quint": "0.34.0",
    "@types/node": "22.20.5",
    "fast-check": "4.11.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
